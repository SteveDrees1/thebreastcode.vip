# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ---------------------------------------------
# Neon dashboard -> Connection string -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin, no trailing slash. Vercel sets this automatically in prod.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Magic-link email (Resend, Postmark, SES... anything SMTP) -------------
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="The Breast Code <no-reply@thebreastcode.vip>"

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the dashboard webhook endpoint in prod.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the all-access subscription (create in the Stripe dashboard).
STRIPE_SUBSCRIPTION_PRICE_ID="price_..."

# --- Object storage for the PDFs (Cloudflare R2 or any S3-compatible) ------
# The bucket holding the sellable PDFs MUST be private. Downloads are served
# through short-lived presigned URLs minted only after an entitlement check.
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="thebreastcode-pdfs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Seconds a download link stays valid.
DOWNLOAD_URL_TTL_SECONDS="300"

# --- Referral programme ----------------------------------------------------
# How many successful referrals earn a free product of the referrer's choice.
REFERRALS_PER_REWARD="3"
